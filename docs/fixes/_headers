# Cloudflare Pages — recommended headers
# রাখুন: public/_headers  (Next.js static export-এ out/_headers-এ কপি হবে)
# ব্রাউজারে ডেপ্লয়ের আগে অবশ্যই টেস্ট করুন — CSP ভুল হলে সাইট ব্লক হতে পারে।

# 1) Hashed Next.js assets — long-term immutable cache
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/beatnest-icon.*
  Cache-Control: public, max-age=604800

# 2) Admin — no indexing, no framing
/admin*
  X-Robots-Tag: noindex, nofollow
  X-Frame-Options: DENY
  Cache-Control: no-store

# 3) Global security headers
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  # CSP: নিচের host-গুলো আপনার API/CDN অনুযায়ী বদলান।
  # Next.js inline hydration script-এর জন্য 'unsafe-inline' রাখা হয়েছে;
  # পরে nonce/hash দিয়ে tighten করুন।
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://*.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://c.saavncdn.com https://*.saavncdn.com https://*.audius.co https://*.googleusercontent.com; media-src 'self' blob: https://*.saavncdn.com https://*.audius.co; connect-src 'self' https://*.supabase.co https://*.googleapis.com https://*.audius.co https://*.audiusapi.co; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests
